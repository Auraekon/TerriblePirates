{
	"id":"canister_srm_flak",
	"specClass":"missile",
	"missileType":"BOMB",
	"sprite":"graphics/missiles/tp_tackhammer_torpedo.png",
	"size":[12,16],	
	"center":[6,8],
	#"glowColor":[235,255,215,90],
	"glowColor":[85,20,10,50],
	"glowRadius":15,
	#"glowColor":[255,200,100,30],
	#"glowRadius":20,
	"hitGlowRadius":35,
	"fringeColor":[100,15,10,50],
	"coreColor":[255,50,30,125],
	"collisionRadius":16,
	"collisionClass":"MISSILE_FF",
	"explosionColor":[255,225,50,255],  # purely visual, will get a white additively blended core on top of this color
	"explosionRadius":70, # purely visual
	"armingTime":1,
	"engineSpec":{
        "turnAcc":0,
        "turnRate":0,
        "acc":10,
        "dec":10
    },
	"engineSlots":[{
        "id":"ES1",
        "loc":[-10, 0],
        "style":"CUSTOM",
        "styleSpec":{
            "mode":"QUAD_STRIP", # PARTICLES or QUAD_STRIP, determines which params are used
            "engineColor":[225,100,70,255],
            "glowSizeMult":0.5f,
            "contrailDuration":0.5f,
            "contrailWidthMult":0.5f,
            "contrailWidthAddedFractionAtEnd":3,  # can be negative. makes trail spread out/narrow at the end
            "contrailMinSeg":5, # min segment length, in pixels
            "contrailMaxSpeedMult":.0f,
            "contrailAngularVelocityMult":0.5f,
            "contrailSpawnDistMult":.5, # how far away from engine it starts
            "contrailColor":[225,180,150,75],
            "type":"SMOKE" # GLOW or SMOKE; additive or regular blend mode
        },
        "width":2.0,
        "length":4.0,
        "angle":180.0
    }],
    "behaviorSpec":{
        "behavior":"PROXIMITY_FUSE",
        "range":90,
        #"vsMissileRange":100,
        "explosionSpec":{
            "duration":0.1f,
            "radius":180,
            "coreRadius":90, # full damage within core radius - also equal to proximity fuse range
            "collisionClass":PROJECTILE_FF,
            "collisionClassByFighter":PROJECTILE_FIGHTER,
            "particleSizeMin":3.0,
            "particleSizeRange":3.0,
            "particleDuration":1,
            "particleCount":100,
            "particleColor":[255,155,155,255],
            "sound":"tp_canister_explosion"
        },
    }
}
