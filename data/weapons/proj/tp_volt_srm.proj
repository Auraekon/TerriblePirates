{
	"id":"tp_volt_srm",
	"specClass":"missile",
	"onHitEffect":"com.fs.starfarer.api.impl.combat.PilumOnHitEffect",
	"missileType":"MISSILE",
	"sprite":"graphics/missiles/tp_volt_srm.png",
	"size":[10,16],	
	"center":[5,8],
	"collisionRadius":15,
	"collisionClass":"MISSILE_NO_FF",
	"explosionColor":[114,244,255,255],  # purely visual, will get a white additively blended core on top of this color
	"explosionRadius":80, # purely visual
	"explosionSpec":{"duration":0.1f, # not visual
					 "radius":40,
					 "coreRadius":75, # full damage within core radius
					 "collisionClass":HITS_SHIPS_AND_ASTEROIDS,
					 "collisionClassByFighter":HITS_SHIPS_AND_ASTEROIDS,
					 "particleSizeMin":5.0,
					 "particleSizeRange":3.0,
					 "particleDuration":1,
					 "particleCount":150,
					 "particleColor":[114,244,255,255]},
	"armingTime":0.5,
	"engineSpec":{"turnAcc":500,
				  "turnRate":75,
				  "acc":1500,
				  "dec":300},
	"engineSlots":[{"id":"ES1",
					"loc":[-7, 0],
				    #"style":"TORPEDO_ATROPOS",
				    "style":"CUSTOM",
					"styleSpec":{
						"mode":"QUAD_STRIP", # PARTICLES or QUAD_STRIP, determines which params are used
						"engineColor":[69,136,254,255],
						"glowSizeMult":1.1,
						"glowAlternateColor":[144,255,230,150],
						"contrailDuration":4,
						"contrailWidthMult":0.8,
						"contrailWidthAddedFractionAtEnd":-0.4f,  # can be negative. makes trail spread out/narrow at the end
						"contrailMinSeg":5, # min segment length, in pixels
						"contrailMaxSpeedMult":.0f,
						"contrailAngularVelocityMult":1f,
						"contrailSpawnDistMult":.5, # how far away from engine it starts
						"contrailColor":[115,217,225,45],
						"type":"SMOKE" # GLOW or SMOKE; additive or regular blend mode
					},
				    "width":15.87,
				    "length":30,
				    "angle":180.0}]
}