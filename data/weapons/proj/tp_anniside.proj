{
	"id":"tp_anniside",
	"specClass":"missile",
	"missileType":"ROCKET",
	#"onHitEffect":"com.fs.starfarer.api.impl.combat.BreachOnHitEffect",
	"sprite":"graphics/missiles/tp_anniside_rocket.png",
	"size":[6,12],
	"center":[3,6],
	"collisionRadius":8,
	"collisionClass":"MISSILE_FF",
	"explosionColor":[255,74,20,255],  # purely visual, will get a white additively blended core on top of this color
	"explosionRadius":144, # purely visual
	#"alwaysAccelerate":true,
	"explosionSpec":{"duration":0.1f, # not visual
					 "radius":40,
					 "coreRadius":26, # full damage within core radius
					 "collisionClass":HITS_SHIPS_AND_ASTEROIDS,
					 "collisionClassByFighter":HITS_SHIPS_AND_ASTEROIDS,
					 "particleSizeMin":5.0,
					 "particleSizeRange":3.0,
					 "particleDuration":1,
					 "particleCount":30,
					 "particleColor":[255,165,146,255]},
	"flameoutTime":3, # total time from flameout to full fadeout
	"armingTime":.05,
	"noEngineGlowTime":0.5, # time spent without the engine glow being rendered
	"fadeTime":0.5, # fadeout duration					 
	"engineSpec":{"turnAcc":100,
				  "turnRate":15,
				  "acc":500,
				  "dec":125},
	"engineSlots":[{"id":"ES1",
					"loc":[-6, 0],
				    "style":"CUSTOM",
					"styleSpec":{
						"mode":"QUAD_STRIP", # PARTICLES or QUAD_STRIP, determines which params are used
						"engineColor":[255,52,44,255],
						"glowSizeMult":1.2,
						"contrailDuration":0.8,
						"contrailWidthMult":0.5,
						"contrailWidthAddedFractionAtEnd":3,  # can be negative. makes trail spread out/narrow at the end
						"contrailMinSeg":5, # min segment length, in pixels
						"contrailMaxSpeedMult":.0f,
						"contrailAngularVelocityMult":0.5f,
						"contrailSpawnDistMult":.5, # how far away from engine it starts
						"contrailColor":[255,94,67,75],
						"type":"SMOKE" # GLOW or SMOKE; additive or regular blend mode
					},
				    "width":8.96,
				    "length":34.56,
				    "angle":180.0}]
}